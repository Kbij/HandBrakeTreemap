# Normalise line endings; keep Windows-specific files CRLF.
* text=auto

*.cs      text diff=csharp
*.axaml   text
*.csproj  text
*.md      text
*.json    text
*.manifest text

*.sln     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

*.png     binary
*.ico     binary
