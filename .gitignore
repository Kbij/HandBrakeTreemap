[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Aa][Rr][Mm]64/
[Ll]og/
[Ll]ogs/
artifacts/
publish/
*.pubxml.user

# Visual Studio
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser
_ReSharper*/
*.DotSettings.user
.idea/
*.sln.iml

# Rider / VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# NuGet
*.nupkg
*.snupkg
.nuget/
packages/
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json

# Test results / coverage
[Tt]est[Rr]esult*/
*.trx
